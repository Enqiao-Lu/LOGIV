(define (domain move-can-pot)
  (:requirements :strips :typing :negative-preconditions)
  (:types arm can pot)
  (:predicates
    (empty ?arm - arm)
    (can-arm ?arm - arm ?can - can)
    (pot-arm ?arm - arm ?pot - pot)
    (target-pot ?can - can ?pot - pot)
    (can-on-table ?can - can)
    (pot-on-table ?pot - pot)
    (holding-can ?arm - arm ?can - can)
    (holding-pot ?arm - arm ?pot - pot)
    (lifted ?can - can)
    (pot-aligned ?pot - pot)
    (beside ?can - can ?pot - pot)
  )
  (:action grasp-can
    :parameters (?arm - arm ?can - can ?pot - pot)
    :precondition (and
      (empty ?arm)
      (can-arm ?arm ?can)
      (can-on-table ?can)
      (target-pot ?can ?pot)
    )
    :effect (and
      (holding-can ?arm ?can)
      (not (empty ?arm))
      (not (can-on-table ?can))
      (not (lifted ?can))
      (not (beside ?can ?pot))
    )
  )
  (:action lift-can
    :parameters (?arm - arm ?can - can)
    :precondition (holding-can ?arm ?can)
    :effect (lifted ?can)
  )
  (:action place-can-beside-pot
    :parameters (?arm - arm ?can - can ?pot - pot)
    :precondition (and
      (holding-can ?arm ?can)
      (lifted ?can)
      (target-pot ?can ?pot)
      (pot-on-table ?pot)
      (pot-aligned ?pot)
    )
    :effect (and
      (beside ?can ?pot)
      (can-on-table ?can)
      (empty ?arm)
      (not (holding-can ?arm ?can))
      (not (lifted ?can))
    )
  )
  (:action grasp-pot
    :parameters (?arm - arm ?pot - pot)
    :precondition (and
      (empty ?arm)
      (pot-arm ?arm ?pot)
      (pot-on-table ?pot)
    )
    :effect (and
      (holding-pot ?arm ?pot)
      (not (empty ?arm))
      (not (pot-on-table ?pot))
      (not (pot-aligned ?pot))
    )
  )
  (:action align-pot
    :parameters (?arm - arm ?pot - pot)
    :precondition (holding-pot ?arm ?pot)
    :effect (and
      (pot-aligned ?pot)
      (pot-on-table ?pot)
      (empty ?arm)
      (not (holding-pot ?arm ?pot))
    )
  )
)
