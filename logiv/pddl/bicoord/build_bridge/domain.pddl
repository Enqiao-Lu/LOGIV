(define (domain build-bridge)
  (:requirements :strips :typing :negative-preconditions)
  (:types arm support beam)
  (:predicates
    (empty ?arm - arm)
    (left-arm ?arm - arm)
    (right-arm ?arm - arm)
    (support-arm ?arm - arm ?support - support)
    (spans ?beam - beam ?first ?second - support)
    (support-on-table ?support - support)
    (holding-support ?arm - arm ?support - support)
    (support-ready ?support - support)
    (beam-on-table ?beam - beam)
    (beam-held ?beam - beam)
    (bridge-ready ?beam - beam ?first ?second - support)
  )
  (:action pick-support
    :parameters (?arm - arm ?support - support)
    :precondition (and
      (empty ?arm)
      (support-arm ?arm ?support)
      (support-on-table ?support)
    )
    :effect (and
      (holding-support ?arm ?support)
      (not (empty ?arm))
      (not (support-on-table ?support))
      (not (support-ready ?support))
    )
  )
  (:action place-support
    :parameters (?arm - arm ?support - support)
    :precondition (holding-support ?arm ?support)
    :effect (and
      (support-ready ?support)
      (support-on-table ?support)
      (empty ?arm)
      (not (holding-support ?arm ?support))
    )
  )
  (:action pick-supports
    :parameters (?left ?right - arm ?first ?second - support)
    :precondition (and
      (left-arm ?left)
      (right-arm ?right)
      (empty ?left)
      (empty ?right)
      (support-arm ?left ?first)
      (support-arm ?right ?second)
      (support-on-table ?first)
      (support-on-table ?second)
    )
    :effect (and
      (holding-support ?left ?first)
      (holding-support ?right ?second)
      (not (empty ?left))
      (not (empty ?right))
      (not (support-on-table ?first))
      (not (support-on-table ?second))
      (not (support-ready ?first))
      (not (support-ready ?second))
    )
  )
  (:action place-supports
    :parameters (?left ?right - arm ?first ?second - support)
    :precondition (and
      (left-arm ?left)
      (right-arm ?right)
      (holding-support ?left ?first)
      (holding-support ?right ?second)
    )
    :effect (and
      (support-ready ?first)
      (support-ready ?second)
      (support-on-table ?first)
      (support-on-table ?second)
      (empty ?left)
      (empty ?right)
      (not (holding-support ?left ?first))
      (not (holding-support ?right ?second))
    )
  )
  (:action pick-beam
    :parameters (?left ?right - arm ?beam - beam)
    :precondition (and
      (left-arm ?left)
      (right-arm ?right)
      (empty ?left)
      (empty ?right)
      (beam-on-table ?beam)
    )
    :effect (and
      (beam-held ?beam)
      (not (beam-on-table ?beam))
      (not (empty ?left))
      (not (empty ?right))
    )
  )
  (:action put-beam-down
    :parameters (?left ?right - arm ?beam - beam)
    :precondition (and
      (left-arm ?left)
      (right-arm ?right)
      (beam-held ?beam)
    )
    :effect (and
      (beam-on-table ?beam)
      (empty ?left)
      (empty ?right)
      (not (beam-held ?beam))
    )
  )
  (:action place-beam
    :parameters (?left ?right - arm ?beam - beam ?first ?second - support)
    :precondition (and
      (left-arm ?left)
      (right-arm ?right)
      (spans ?beam ?first ?second)
      (beam-held ?beam)
      (support-ready ?first)
      (support-ready ?second)
    )
    :effect (and
      (bridge-ready ?beam ?first ?second)
      (empty ?left)
      (empty ?right)
      (not (beam-held ?beam))
    )
  )
)
